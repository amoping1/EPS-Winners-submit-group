# Copy this file to .env and fill in the values you need.
# .env is gitignored. Never commit real API keys or tokens.

# Which provider the LLM adapter uses first, and which it fails over to if the
# primary rate-limits or errors during the 45-minute final-run window.
LLM_PRIMARY=openai
LLM_FALLBACK=

# Credentials. Only the provider(s) you actually use need a value.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model routing. Bulk work -- extraction, classification, date parsing -- goes to
# MODEL_FAST. Only forecasting and adversarial validation use MODEL_REASONING.
MODEL_FAST=
MODEL_REASONING=

# Spend ceiling in USD. When it is reached the system does not stop: it degrades
# remaining metrics to the deterministic statistical path and flags them
# low-confidence, because an empty forecast cell scores the maximum penalty.
MAX_USD_BUDGET=40

# Optional tuning.
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=4
MAX_WORKERS=4
BACKTEST_EVENTS=8
